package com.daksh.springprogram01.entities;

public class Student {
	private String name;
	private int age;
	private String city;
	public String getName() {
		return name;
	}
	public void setName(String name) {
		this.name = name;
	}
	public int getAge() {
		return age;
	}
	public void setAge(int age) {
		this.age = age;
	}
	public String getCity() {
		return city;
	}
	public void setCity(String city) {
		this.city = city;
	}
	public void print() {
		System.out.print(name+" "+age+" "+city);
	}
}






























IOC and dependency

package com.daksh.student_management;

/**
 * Hello world!
 *
 */
import org.springframework.context.ApplicationContext;
import org.springframework.context.annotation.AnnotationConfigApplicationContext;
public class App 
{
	
    public static void main( String[] args )
    {
        ApplicationContext context= new AnnotationConfigApplicationContext("com.daksh.student_management");
        
        System.out.println("Spring container started");
        
        StudentService service =
                context.getBean(StudentService.class);

        service.printMessage();

    }
}


package com.daksh.student_management;
import org.springframework.stereotype.Component;

@Component
public class MessageService {
	 public MessageService() {
	     System.out.println("MessageService object created by Spring");
	 }
	 public String getMessage() {
	     return "Hello Spring IoC";
	 }
}


package com.daksh.student_management;

import org.springframework.stereotype.Component;
@Component
public class StudentService {
	private final MessageService messageservice;
	public StudentService(MessageService messageservice) {
		this.messageservice=messageservice;
        System.out.println("StudentService created");
	}
	public void printMessage() {
        System.out.println(messageservice.getMessage());
    }
}





