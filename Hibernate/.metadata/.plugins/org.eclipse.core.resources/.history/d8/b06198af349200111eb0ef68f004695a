package com.daksh.hibernate_demo;

import java.util.Scanner;
import com.daksh.hibernate_demo.Studentservice;
import com.daksh.hibernate_demo.entities.Student;
public class App 
{
    public static void main( String[] args )
    {
    	Scanner sc=new Scanner(System.in);
		while(true) {
			System.out.println("Select Options");
			System.out.println("Option 1: Insert new student");
			System.out.println("Option 2: Update student city");
			System.out.println("Option 3: Get Student id");
			System.out.println("Option 4: Delete Student by id");
			
			int n=sc.nextInt();
			switch(n) {
			case 1: {
			    Student s1 = new Student();

			    System.out.println("Enter name:");
			    String a = sc.next();
			    s1.setName(a);
			    System.out.println("Enter city:");
			    String c = sc.next();
			    s1.setCity(c);
			    sc.nextLine();
			    System.out.println("Enter review:");
			    String r = sc.nextLine();
			    s1.setReview(r);

			    Studentservice.insert(s1);
			}break;
			case 2:{
				Student s2=new Student();
				System.out.println("Enter id:");
				int id=sc.nextInt();
				System.out.println("Enter city:");
				String str=sc.next();
				s2.setCity(str);
				Studentservice.update(id,s2);
			}break;
			
			}
		}
    }
}
