package com.daksh.hibernate_demo;

/**
 * Hello world!
 *
 */
import org.hibernate.*;
import com.daksh.hibernate_demo.util.*;
import com.daksh.hibernate_demo.entities.*;
public class App 
{
    public static void main( String[] args )
    {
        System.out.println( "Hello World!" );
        SessionFactory sessionfactory = Sessionbuilder.getSessionFactory();
        System.out.print(sessionfactory);
        
        Student s1=new Student();
        s1.setName("daksh");
        s1.setCity("Mohali");
        s1.setReview("it is a good school to study");
        Session session=sessionfactory.openSession();
        
        Transaction transaction=null;
        try {
        	transaction=session.beginTransaction();
        	session.persist(s1);
        	transaction.commit();
        }catch(Exception e) {
        	e.printStackTrace();
        }finally {
        	session.close();
        }
        
    }
}
